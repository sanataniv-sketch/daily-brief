# Copy to .env and fill in. .env is gitignored — never commit it.

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub Personal Access Token (classic) with scopes: repo, workflow.
# Used ONLY locally to create/push the repo and set the Actions secret.
# The scheduled workflow itself publishes with GitHub's built-in token.
GITHUB_TOKEN=

# Optional: override the published site base (no trailing slash).
# SITE_BASE_URL=https://sanataniv-sketch.github.io/daily-brief

# Optional: set to 1 locally to bypass the 05:30 ET time guard for testing.
# FORCE_RUN=1
